---
import LearningLayout from "../layouts/LearningLayout.astro";
import ScanCycleIsland from "../components/ScanCycleIsland.astro";
---

<LearningLayout title="Salbotics PLC Learning Hub">
  <main>
    <section class="hero">
      <div>
        <h1>One portable place to learn PLC.</h1>
        <p>
          Salbotics PLC Learning Hub teaches scan cycles, Ladder thinking,
          industrial HMI patterns, oil-palm automation context, and safety
          awareness through a local simulator and static learning pages.
        </p>
        <div class="hero-actions">
          <a class="button-link" href="https://github.com/SaladinIART/salbotics-plc-learning-hub">View GitHub</a>
          <a class="button-link" href="./how-it-works/">Open migrated guide</a>
        </div>
      </div>
      <ScanCycleIsland />
    </section>

    <section class="panel">
      <h2>Phase 1 publishing focus</h2>
      <div class="grid">
        <article class="card">
          <h3>Static learning hub</h3>
          <p>Astro provides reusable layouts for public pages, docs, and recruiter-facing demos.</p>
        </article>
        <article class="card">
          <h3>Local simulator</h3>
          <p>FastAPI and the Python PLC engine stay local for interactive input/output training.</p>
        </article>
        <article class="card callout">
          <h3>Safety boundary</h3>
          <p>The public demo is educational only and does not expose live PLC-control endpoints.</p>
        </article>
      </div>
    </section>
  </main>
</LearningLayout>
