<section class="scan-island" aria-labelledby="scan-island-title">
  <div>
    <h2 id="scan-island-title">Interactive Scan-Cycle SVG Island</h2>
    <p>
      The first Astro island proves the future frontend can keep PLC diagrams fluid
      without moving the Python simulator into the public static demo.
    </p>
    <div class="step-buttons" aria-label="Scan cycle step selector">
      <button type="button" data-step="0">1. Inputs</button>
      <button type="button" data-step="1">2. Logic</button>
      <button type="button" data-step="2">3. Outputs</button>
      <button type="button" data-step="3">4. Repeat</button>
    </div>
  </div>

  <svg viewBox="0 0 720 280" role="img" aria-label="PLC scan cycle diagram">
    <defs>
      <marker id="arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto">
        <path d="M0,0 L0,6 L9,3 z" fill="#38bdf8"></path>
      </marker>
    </defs>
    <rect x="20" y="24" width="680" height="220" rx="14" class="svg-bg"></rect>
    <g class="scan-node active" data-node="0" transform="translate(56 86)">
      <rect width="132" height="78" rx="8"></rect>
      <text x="66" y="32">Read Inputs</text>
      <text x="66" y="54">I0.x bits</text>
    </g>
    <g class="scan-node" data-node="1" transform="translate(220 86)">
      <rect width="132" height="78" rx="8"></rect>
      <text x="66" y="32">Solve Logic</text>
      <text x="66" y="54">LAD rungs</text>
    </g>
    <g class="scan-node" data-node="2" transform="translate(384 86)">
      <rect width="132" height="78" rx="8"></rect>
      <text x="66" y="32">Write Outputs</text>
      <text x="66" y="54">Q0.x coils</text>
    </g>
    <g class="scan-node" data-node="3" transform="translate(548 86)">
      <rect width="132" height="78" rx="8"></rect>
      <text x="66" y="32">Repeat</text>
      <text x="66" y="54">100ms scan</text>
    </g>
    <line x1="188" y1="125" x2="220" y2="125" marker-end="url(#arrow)"></line>
    <line x1="352" y1="125" x2="384" y2="125" marker-end="url(#arrow)"></line>
    <line x1="516" y1="125" x2="548" y2="125" marker-end="url(#arrow)"></line>
    <path d="M614 164 C600 236, 120 236, 120 166" marker-end="url(#arrow)"></path>
  </svg>
</section>

<script>
  document.querySelectorAll(".scan-island").forEach((island) => {
    const buttons = island.querySelectorAll("[data-step]");
    const nodes = island.querySelectorAll("[data-node]");

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const step = button.getAttribute("data-step");
        nodes.forEach((node) => node.classList.toggle("active", node.getAttribute("data-node") === step));
        buttons.forEach((item) => item.classList.toggle("active", item === button));
      });
    });
  });
</script>

<style>
  .scan-island {
    display: grid;
    grid-template-columns: minmax(260px, 0.7fr) minmax(360px, 1fr);
    gap: 14px;
    align-items: center;
    margin-top: 12px;
    padding: 16px;
    border: 1px solid #b8c5d6;
    border-radius: 8px;
    background: #ffffff;
    color: #0f172a;
  }

  .scan-island h2 {
    margin: 0;
    font-size: 18px;
  }

  .step-buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 12px;
  }

  .step-buttons button {
    min-height: 34px;
    border: 1px solid #0ea5e9;
    border-radius: 5px;
    background: #ecfeff;
    color: #0e7490;
    font: inherit;
    font-size: 12px;
    font-weight: 900;
    cursor: pointer;
  }

  .step-buttons button.active,
  .step-buttons button:hover {
    background: #0e7490;
    color: #ffffff;
  }

  .scan-island svg {
    width: 100%;
    min-width: 0;
    height: auto;
  }

  .svg-bg {
    fill: #f8fafc;
    stroke: #b8c5d6;
  }

  .scan-node rect {
    fill: #eef2ff;
    stroke: #818cf8;
    stroke-width: 2;
  }

  .scan-node.active rect {
    fill: #dcfce7;
    stroke: #22c55e;
  }

  .scan-node text {
    fill: #0f172a;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 13px;
    font-weight: 900;
    text-anchor: middle;
  }

  .scan-node text:nth-of-type(2) {
    fill: #475569;
    font-size: 11px;
  }

  line,
  path {
    fill: none;
    stroke: #38bdf8;
    stroke-width: 3;
  }

  @media (max-width: 760px) {
    .scan-island {
      grid-template-columns: 1fr;
      overflow-x: auto;
    }

    .scan-island svg {
      min-width: 620px;
    }
  }
</style>
